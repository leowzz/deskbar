{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskBar 连接助手",
  "version": "0.1.6",
  "identifier": "app.deskbar.agent",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1432",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeskBar 连接助手",
        "width": 1040,
        "height": 760,
        "minWidth": 560,
        "minHeight": 560,
        "backgroundColor": "#ffffff",
        "theme": "Light"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; font-src 'self' data:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "12.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExQkZCQ0REQzUzMTYyRUIKUldUcllqSEYzYnkvb2RxVlhDbW5mTXF6eDZoYURNckFIQU9aUnloZVJVZHNNakJRb1pmVzV4N1oK",
      "endpoints": [
        "https://github.com/leowzz/deskbar/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
